# Build output and caches. No leading path component, so they match at any depth - templates sit three levels down.
packer_cache/
.vagrant/
output/
# packer-plugin-proxmox writes the ISO it downloads into a directory of this
# name beside the template, whatever iso_target_path says.
downloaded_iso_path/

# Crash log
crash.log

# For built boxes
*.box

# FreeFileSync
*.ffs_lock
*.ffs_db

# - Temporary files and directories.
# - Deliberately NOT *tmp* / *temp*: those substring globs match any path containing "temp", which in a repository full of *template* files silently swallows real content.
*.tmp
*.temp
tmp/
temp/

# Personal editor/agent settings; records absolute paths from one machine.
# The shared half, .claude/settings.json, is not ignored.
.claude/settings.local.json

# - Secrets and credentials.
# - Anything sensitive belongs in the environment (PKR_VAR_*), never a file.
# - proxmox.pkrvars.hcl is not secret but describes one node, so it is ignored and committed only as .example.
proxmox.pkrvars.hcl
*.local.pkrvars.hcl
*secret*.pkrvars.hcl
*.tfvars
*.kdbx
.env
.env.*
*.pem
*.key
*_rsa
*_ed25519

# OpenTofu / Terraform state
.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.*

# Packer logs
packer.log
*.packer.log
