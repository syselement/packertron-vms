# Node settings shared by every template under templates/proxmox/.
#
#   cp proxmox.pkrvars.hcl.example proxmox.pkrvars.hcl
#   packer build -var-file=../proxmox.pkrvars.hcl .
#
# The copy is gitignored.
#
# CREDENTIALS DO NOT BELONG HERE - the API token comes from the environment:
#
#   export PKR_VAR_proxmox_api_token_id="packer@pve!templates"
#   export PKR_VAR_proxmox_api_token_secret="..."
#
# See ../../SECURITY.md.

# Where the API lives. Include the scheme, the port and /api2/json.
proxmox_api_url = "https://proxmox.example.lan:8006/api2/json"

# The node name as Proxmox shows it, which is not always the hostname.
proxmox_node = "pve"

# - iso_storage_pool must accept content type "iso"; storage_pool must accept "images", and also holds the EFI variable disk and the cloud-init drive.
# - Check Datacenter -> Storage for the real names.
iso_storage_pool = "local"
storage_pool     = "vmstore"

# Needs DHCP and outbound access: the installer fetches packages.
network_bridge = "vmbr0"

# Leave false. Set it to true only for a node presenting a self-signed certificate that you have deliberately chosen to accept.
insecure_skip_tls_verify = false
