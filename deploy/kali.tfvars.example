# Clone the Kali template into a running VM.
#
#   cp kali.tfvars.example kali-01.tfvars       # *.tfvars is gitignored
#   tofu workspace new kali-01                  # its own state, beside the others
#   export PROXMOX_VE_API_TOKEN='automation@pve!deploy=xxxxxxxx-...'
#   export TF_VAR_state_passphrase='...'        # 16+ characters; encrypts the state
#   export TF_VAR_password='...'                # REQUIRED: Xfce has no key login
#   tofu apply -var-file=kali-01.tfvars
#
# THE API TOKEN DOES NOT BELONG HERE, and neither do the passphrase and the
# password.

proxmox_endpoint = "https://proxmox.example.lan:8006/" # no /api2/json, unlike Packer
proxmox_node     = "pve"
proxmox_insecure = false # true only for a self-signed node
datastore_id     = "vmstore"

ssh_authorized_keys = [
  "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIexampleexampleexampleexampleexample you@workstation",
]

vms = {
  "kali-01" = {
    template_vm_id = 80200
    os             = "kali"
    cores          = 4
    memory         = 4096

    # Must be >= 50: the Kali template's disk is 50G, and Proxmox can grow a
    # cloned disk but never shrink one. The default of 32 fails the apply.
    disk_size = 50

    # Kali ships its toolset in the image, so os = "kali" makes the module
    # refuse provisioning_steps rather than start a first boot that cannot run.
    tags = ["opentofu", "kali"]
  }
}
