# Cache objects
*/packer_cache/
*/.vagrant

# Crash log
crash.log

# For built boxes
*.box
*/output

# FreeFileSync
*.ffs_lock
*.ffs_db

# Temporary files and directories
*.tmp
*.temp
*tmp*
*temp*
tmp/
temp/

# Secrets and credentials
# The tracked *.auto.pkrvars.hcl files hold ISO URLs and checksums only. Keep
# anything sensitive in a *.local.pkrvars.hcl beside them, or in the
# environment (PROXMOX_VE_*), so it can never be committed by accident.
*.local.pkrvars.hcl
*secret*.pkrvars.hcl
*.tfvars
*.kdbx
.env
.env.*
*.pem
*.key
*_rsa
*_ed25519

# OpenTofu / Terraform state
.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.*

# Packer logs
packer.log
*.packer.log
