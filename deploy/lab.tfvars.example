# The whole lab in one map, one apply. The module creates one VM per entry, so
# adding a key adds a machine and removing one destroys it.
#
#   cp lab.tfvars.example lab.tfvars          # *.tfvars is gitignored
#   tofu workspace new lab                    # its own state
#   tofu apply -var-file=lab.tfvars
#
# To bring machines up one at a time instead, keep a file per VM holding a
# single-entry map and give each its own workspace. Same module either way.
#
# THE API TOKEN AND THE STATE PASSPHRASE DO NOT BELONG HERE:
#   export PROXMOX_VE_API_TOKEN='automation@pve!deploy=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx'
#   export TF_VAR_state_passphrase='...'   # 16+ characters; encrypts the state
# Nor does a console password. Servers do not need one - SSH takes the key.
# DESKTOPS DO: GDM and the Proxmox console have no key login, and cloud-init
# locks the account when no password is delivered, so a desktop clone created
# without one cannot be logged into at all:
#   export TF_VAR_password='...'
# cloud-init applies it on the first boot only; for a desktop already created
# without one, SSH in with the key and run  sudo passwd <user>

proxmox_endpoint = "https://proxmox.example.lan:8006/"
proxmox_node     = "pve"
proxmox_insecure = false
datastore_id     = "vmstore"

ssh_authorized_keys = [
  "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIexampleexampleexampleexampleexample you@workstation",
]

vms = {
  # Each key is the VM's name and hostname, with one dash, before the
  # number: srv and ws are Linux, win10, win11 and winsrv25 are Windows.
  # Windows truncates a hostname past 15 characters.
  #
  # Only template_vm_id is required, so the common case is one line.
  "srv-01" = {
    template_vm_id = 80026
  }

  # A static address needs both fields; leave them out for DHCP.
  "srv-02" = {
    template_vm_id = 80026
    ipv4_address   = "192.168.1.201/24"
    ipv4_gateway   = "192.168.1.1"
  }

  # A linked clone is faster and smaller, but keeps the template undeletable.
  "srv-03" = {
    template_vm_id = 80026
    full_clone     = false
  }

  # Another network than the template's NIC: a VLAN tag on vmbr0, or a
  # different bridge. Leave both out and the clone keeps the template's NIC.
  "srv-04" = {
    template_vm_id = 80026
    vlan_id        = 30
  }

  # The workstation: 02 then 03 give the full toolchain, GNOME preferences and
  # shell configuration. Runs in the background for 30-40 minutes after apply
  # returns, then reboots once. disk_size must be >= the template's 64G.
  "ws-01" = {
    template_vm_id     = 80126
    cores              = 4
    memory             = 8192
    disk_size          = 64
    provisioning_steps = "02,03"
  }

  # Kali carries its toolset in the image; with os = "kali", a
  # provisioning_steps request is refused at plan time.
  "kali-01" = {
    template_vm_id = 80200
    os             = "kali"
    cores          = 4
    memory         = 4096
    disk_size      = 50
    tags           = ["opentofu", "kali"]
  }

  # Windows: cloudbase-init applies the hostname, account, password and key
  # from the same cloud-init drive, and reboots once. disk_size must be >= the
  # templates' 64G. The console needs TF_VAR_password; Windows has no key
  # login there.
  "win10-01" = {
    template_vm_id = 80310
    os             = "windows"
    cores          = 4
    memory         = 4096
    disk_size      = 64
    tags           = ["opentofu", "windows"]
  }

  # "utils" installs Chocolatey, its utilities and UniGetUI at first boot -
  # scripts/windows/install_utils.ps1, run once by cloudbase-init.
  "win11-01" = {
    template_vm_id     = 80311
    os                 = "windows"
    provisioning_steps = "utils"
    cores              = 4
    memory             = 4096
    disk_size          = 64
    tags               = ["opentofu", "windows"]
  }

  # Server keeps the built-in Administrator rather than the shared username,
  # and refuses a password without three of upper case, lower case, digits and
  # symbols: a simple TF_VAR_password leaves it with a random one.
  "winsrv25-01" = {
    template_vm_id = 80325
    os             = "windows"
    username       = "Administrator"
    cores          = 4
    memory         = 4096
    disk_size      = 64
    tags           = ["opentofu", "windows"]
  }
}
