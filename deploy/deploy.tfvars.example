# Copy to a *.tfvars of your own, which is gitignored, and edit.
#
#   cp deploy.tfvars.example deploy.tfvars
#   tofu apply -var-file=deploy.tfvars
#
# THE API TOKEN DOES NOT BELONG HERE. It comes from the environment:
#
#   export PROXMOX_VE_API_TOKEN='automation@pve!deploy=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx'
#   export TF_VAR_state_passphrase='...'   # 16+ characters; encrypts the state
#
# See ../SECURITY.md. lab.tfvars.example carries the whole lab in one map;
# this file is the smallest thing that works.

# Include the scheme and the port. Unlike the Packer variable, no /api2/json.
proxmox_endpoint = "https://proxmox.example.lan:8006/"
proxmox_node     = "pve"

# Leave false. Set it true only for a node presenting a self-signed
# certificate that you have deliberately chosen to accept.
proxmox_insecure = false

datastore_id = "vmstore"

# Public keys authorised on every clone, in addition to whatever the template
# already carries.
ssh_authorized_keys = [
  "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIexampleexampleexampleexampleexample you@workstation",
]

# One entry per VM. The key is the VM's name and its cloud-init hostname.
# Only template_vm_id is required - everything else falls back to a plain
# 2 core / 2048 MB / 32 GB server on DHCP.
vms = {
  "srv-01" = {
    template_vm_id = 80026
  }
}
