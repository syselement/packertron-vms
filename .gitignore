# Build output and caches.
# No leading path component, so these match at any depth. They used to be
# written as */packer_cache/ and */output, which anchored them to a template
# directory sitting directly in the repository root; once templates moved under
# templates/<hypervisor>/<os>/ those patterns silently stopped matching.
packer_cache/
.vagrant/
output/

# Crash log
crash.log

# For built boxes
*.box

# FreeFileSync
*.ffs_lock
*.ffs_db

# Temporary files and directories
# Deliberately NOT *tmp* / *temp*: those substring globs match any path
# containing "temp", which in a repository full of *template* files silently
# swallows real content. They already dropped a workflow named
# template-checks.yml from a commit without reporting anything.
*.tmp
*.temp
tmp/
temp/

# Editor and agent local settings
# settings.local.json is the personal half of the Claude Code config, by its
# own convention; it also records absolute paths from one machine. The shared
# half would be .claude/settings.json, which is not ignored.
.claude/settings.local.json

# Secrets and credentials
# The tracked *.auto.pkrvars.hcl files hold ISO URLs and checksums only. Keep
# anything sensitive in the environment (PKR_VAR_*), so it can never be
# committed by accident.
#
# templates/proxmox/proxmox.pkrvars.hcl holds one node's settings - hostname,
# storage pools, bridge. Not secret, but not shareable either, so it is
# ignored and committed only as .example. Same for any *.local.pkrvars.hcl.
proxmox.pkrvars.hcl
*.local.pkrvars.hcl
*secret*.pkrvars.hcl
*.tfvars
*.kdbx
.env
.env.*
*.pem
*.key
*_rsa
*_ed25519

# OpenTofu / Terraform state
.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.*

# Packer logs
packer.log
*.packer.log
